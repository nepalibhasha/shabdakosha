# Python-generated files
# __pycache__/
# *.py[oc]
# build/
# dist/
# wheels/
# *.egg-info


# Ignore everything by default
*

# But DO NOT ignore the following:
!/.gitignore
!/.dockerignore
!/create_db.py
!/Dockerfile
!/compose.yaml
!/shabdakosha/
!/shabdakosha/**
/shabdakosha/**/__pycache__/
/shabdakosha/**/*.pyc
!/scripts/
!/scripts/*
!/tests/
!/tests/*
!/docs/
!/docs/*
!/data/
!/data/*
!/data/source/
!/data/source/Sabdakosh10th.pdf
!/data/source/SanketaChinha.pdf
!/data/dictionaries/
!/data/dictionaries/*/
!/data/dictionaries/*/metadata.json
!/data/dictionaries/*/headword_resolutions.jsonl
!/data/dictionaries/*/entries/
!/data/dictionaries/*/entries/*/
!/data/dictionaries/*/entries/*/*.txt
!/data/dictionaries/*/source/
!/data/dictionaries/*/source/*.json.gz
/data/*.db
/data/*.db-*

!uv.lock
!pyproject.toml
!README.md
!AGENTS.md

# Virtual environments
.venv
