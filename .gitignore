# Python-generated files
# __pycache__/
# *.py[oc]
# build/
# dist/
# wheels/
# *.egg-info


# Ignore everything by default
*

# But DO NOT ignore the following:
!/.gitignore
!/create_db.py
!/scripts/
!/scripts/*
!/docs/
!/docs/*
!/data/
!/data/*
!/data/source/
!/data/source/Sabdakosh10th.pdf
!/data/source/SanketaChinha.pdf
!/data/dictionaries/
!/data/dictionaries/*/
!/data/dictionaries/*/metadata.json
!/data/dictionaries/*/entries/
!/data/dictionaries/*/entries/*/
!/data/dictionaries/*/entries/*/*.txt
/data/*.db
/data/*.db-*

!uv.lock
!pyproject.toml
!README.md

# Virtual environments
.venv
